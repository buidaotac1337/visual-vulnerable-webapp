# Local development environment defaults for VVWA (copy to .env if customizing)
POSTGRES_DB=minishop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

VVWA_ENVIRONMENT=local
VVWA_CORS_ORIGINS=http://localhost:5173
VVWA_DATABASE_URL=postgresql://lab_app_user:lab_app_pass@postgres:5432/minishop
VVWA_ADMIN_DATABASE_URL=postgresql://lab_admin_user:lab_admin_pass@postgres:5432/minishop
VVWA_SSRF_ALLOWED_HOSTS=minishop-cdn
# VVWA_UPLOAD_SANDBOX_DIR=/tmp/vvwa-uploads
