{
  "name": "vvwa-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=26.13.1 <27.0.0",
    "pnpm": ">=10.12.1 <11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "cd ../.. && eslint -c core/frontend/eslint.config.js core/frontend \"labs/*/frontend/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format": "prettier --config .prettierrc.json --write . \"../../labs/*/frontend/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --config .prettierrc.json --check . \"../../labs/*/frontend/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@tailwindcss/vite": "4.1.8",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.11",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.1",
    "eslint": "9.28.0",
    "eslint-plugin-jsdoc": "50.6.17",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
}
